        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/../out",
      "cacheVariables": {
        "CMAKE_INTERMEDIATE_DIR_STRATEGY": "SHORT",
        "MSWORD_STATIC_CRT": "ON"
      }
    },
    {
      "name": "x64-debug",
      "displayName": "Word x64 Debug",
