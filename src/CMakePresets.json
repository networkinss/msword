      "inherits": "x64"
    },
    {
      "name": "x64-clang",
      "hidden": true,
      "inherits": "x64",
      "toolset": {
        "value": "ClangCL",
        "strategy": "set"
      }
    },
    {
      "name": "x64-clang-debug",
      "displayName": "Word x64 Debug (clang-cl)",
      "inherits": "x64-clang"
    },
    {
      "name": "x64-clang-release",
      "displayName": "Word x64 Release (clang-cl)",
